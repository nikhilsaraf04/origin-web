# Origin Web — environment variables
# Copy this to .env.local and fill in real values. .env.local is gitignored.

# Required: Anthropic API key, used server-side only by /api/scan.
# Get one from https://console.anthropic.com/
# NEVER expose this client-side.
ANTHROPIC_API_KEY=

# Single-user auth. The passcode you type on the sign-in screen, and the
# HMAC secret used to sign session tokens. Set both as Fly secrets in prod:
#   fly secrets set ORIGIN_PASSCODE=... ORIGIN_TOKEN_SECRET=... -a origin-coffee
ORIGIN_PASSCODE=
ORIGIN_TOKEN_SECRET=

# Where the SQLite file lives. Defaults to /data/origin.db (the Fly volume);
# for local `next dev` point it at a repo-local file.
ORIGIN_DB_PATH=./origin.local.db
